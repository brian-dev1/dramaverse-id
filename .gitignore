*.log
.DS_Store
# Semua varian .env diabaikan, kecuali contoh yang memang harus ikut.
# Daftar eksplisit sebelumnya (.env, .env.backup, .env.production) tidak
# menutup nama lain seperti .env.bak atau .env.old — dan itu terbukti:
# sebuah `git add -A` yang dijalankan di VPS menyapu .env.bak berisi
# kredensial produksi ke dalam commit.
.env
.env.*
!.env.example
.phpactor.json
.phpunit.result.cache
/.fleet
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
Homestead.json
Homestead.yaml
Thumbs.db

# Arsip kerja
*.zip

# Cache Python dari tools/
__pycache__/
*.pyc
