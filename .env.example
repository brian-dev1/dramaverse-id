APP_NAME="DramaVerse ID"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — MySQL
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dramaverse
DB_USERNAME=root
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Telegram — satu-satunya cara pengguna masuk
# ---------------------------------------------------------------------------
# Token dari @BotFather. Rahasia: siapa pun yang memilikinya bisa mengirim
# pesan atas nama bot. Token tidak pernah ditulis ke log — diredaksi lebih
# dulu oleh TelegramClient.
TELEGRAM_BOT_TOKEN=
# Tanpa tanda @.
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHANNEL_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LOGIN_TOKEN_TTL=10

# Kosongkan untuk memakai server resmi Telegram. Diisi hanya bila memakai
# Local Bot API Server sendiri (batas unggah naik dari 50 MB ke 2000 MB).
TELEGRAM_API_URL=

# Batas waktu, dalam detik. Baris kosong jatuh ke bawaan (15 dan 5) —
# BUKAN ke nol, yang berarti menunggu selamanya.
TELEGRAM_TIMEOUT=15
TELEGRAM_CONNECT_TIMEOUT=5

# Percobaan ulang. TIMES adalah jumlah percobaan TOTAL: isi 1 untuk mematikan
# pengulangan. Yang diulang hanya kegagalan koneksi, HTTP 5xx, dan 429.
# Galat 400/401/403 tidak pernah diulang.
TELEGRAM_RETRY_TIMES=3
TELEGRAM_RETRY_SLEEP_MS=400
TELEGRAM_RETRY_MAX_SLEEP_MS=5000
# Detik. Bila Telegram meminta jeda lebih lama dari ini saat kena batas laju,
# permintaan dilaporkan gagal, bukan ditahan di dalam request.
TELEGRAM_RETRY_MAX_WAIT=30

# Log. LOG_PAYLOAD menyertakan isi pesan — tulisan pengguna. Biarkan false
# kecuali sedang menelusuri masalah.
TELEGRAM_LOGGING=true
TELEGRAM_LOG_CHANNEL=
TELEGRAM_LOG_PAYLOAD=false
TELEGRAM_LOG_TEXT_LIMIT=120

# HTML atau MarkdownV2. HTML dipilih karena MarkdownV2 mewajibkan pelolosan
# pada titik, tanda hubung, dan tanda seru yang lazim ada di judul drama.
TELEGRAM_PARSE_MODE=HTML

# Batas Bot API resmi 50 MB. Naikkan hanya bersama TELEGRAM_API_URL sendiri.
TELEGRAM_UPLOAD_MAX_MB=50

# Channel/grup PRIVAT tempat video episode disimpan sekali untuk mendapatkan
# file_id. Bot harus jadi admin di sana. Bentuknya -100xxxxxxxxxx.
# JANGAN dibuat publik: isinya seluruh katalog video termasuk yang berbayar.
TELEGRAM_STORAGE_CHAT_ID=

# Sinkronisasi video ke Telegram. Timeout dalam detik — pengiriman ratusan
# megabyte tidak selesai dalam 15 detik seperti sendMessage.
TELEGRAM_SYNC_TIMEOUT=1800
TELEGRAM_SYNC_MAX_RETRY=3
TELEGRAM_SYNC_QUEUE=default

# Jumlah episode per halaman pada daftar episode di bot.
TELEGRAM_EPISODE_PAGE_SIZE=20

# Otomatisasi. AUTO_SYNC mati secara bawaan: menyalakannya berarti setiap
# unggahan langsung memakan kuota Telegram sebelum ada yang memutuskan berkas
# itu memang akan disajikan lewat bot.
TELEGRAM_AUTO_SYNC=false
TELEGRAM_AUTO_RETRY=true
TELEGRAM_HEALTH_CHECK=true
# Menit. Baris yang tertahan di status Diproses lebih lama dari ini dianggap
# yatim dan dilepaskan — worker yang dibunuh paksa tidak sempat melepaskannya.
TELEGRAM_STUCK_MINUTES=60

# Ke mana peringatan dikirim. Boleh chat pribadi admin; bedakan dari
# TELEGRAM_STORAGE_CHAT_ID. Kosongkan untuk hanya menulis log.
TELEGRAM_ALERT_CHAT_ID=
# Menit. Satu jenis peringatan tidak dikirim lagi selama rentang ini.
TELEGRAM_ALERT_THROTTLE=30

# Pembatas laju. Telegram membatasi sekitar 30 pesan per detik untuk seluruh
# bot; 25 dipilih agar tidak mepet ke batas yang tidak diumumkan persis.
TELEGRAM_RATE_LIMIT=true
TELEGRAM_RATE_PER_SECOND=25
TELEGRAM_RATE_MAX_WAIT_MS=3000

# Cache file_id dan metadata episode.
TELEGRAM_CACHE=true
TELEGRAM_CACHE_TTL=3600

# ---------------------------------------------------------------------------
# Akun admin awal (dipakai UserSeeder)
# ---------------------------------------------------------------------------
ADMIN_SEED_PASSWORD=dramaverse

# ---------------------------------------------------------------------------
# Multi Storage
# ---------------------------------------------------------------------------
# Daftar provider ada di tabel storage_providers, bukan di sini. Kredensial
# R2, B2, Wasabi, dan lainnya dimasukkan lewat panel admin dan disimpan
# terenkripsi memakai APP_KEY.
#
# PERINGATAN: mengganti APP_KEY membuat seluruh kredensial storage di
# database tidak bisa dibaca lagi dan harus dimasukkan ulang.

# Kosongkan pada keadaan normal. Isi dengan slug provider hanya untuk
# memaksa provider tertentu ketika default di database bermasalah.
STORAGE_DEFAULT_PROVIDER=

# Batasi driver yang boleh dipilih admin. Kosong berarti semua boleh.
# Contoh untuk produksi: STORAGE_ALLOWED_DRIVERS=r2,b2,wasabi
# Nilai yang dikenali: local,s3,r2,b2,wasabi,spaces,minio,gcs,azure
STORAGE_ALLOWED_DRIVERS=

STORAGE_DEFAULT_VISIBILITY=private

# Storage Engine.
# require_verified: menolak provider yang belum pernah lulus Test Connection.
# Biarkan false sampai semua provider terbukti lulus — kalau tidak, seluruh
# unggahan gagal di pemasangan baru yang belum pernah menjalankan storage:test.
STORAGE_REQUIRE_VERIFIED=false
STORAGE_ENGINE_LOGGING=true
# Kosong = memakai channel log bawaan aplikasi.
STORAGE_ENGINE_LOG_CHANNEL=
STORAGE_PROBE_DIR=_healthcheck

# Cloudflare R2.
# Rahasia ini TIDAK dibaca langsung oleh bot. Jalankan `php artisan
# storage:r2:setup` setelah mengisinya; command itu menyimpan provider R2 ke
# tabel storage_providers dengan kredensial terenkripsi.
R2_PROVIDER_NAME="Cloudflare R2 Produksi"
R2_PROVIDER_SLUG=r2
R2_ACCOUNT_ID=
# Alternatif bila memakai endpoint khusus/jurisdiction, mis.
# https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
# Prefix folder di dalam bucket. Kosongkan bila ingin mengikuti struktur
# bawaan project: episode/video, episode/thumbnail, drama/poster, dan seterusnya.
R2_ROOT=
# Biarkan kosong untuk video privat. Isi hanya kalau bucket memang dipakai
# untuk berkas publik/CDN.
R2_PUBLIC_URL=
R2_VISIBILITY=private
R2_PRIORITY=10

# Antrean unggah (Sprint 7.7).
#
# Koneksi antrean. `uploads` didefinisikan di config/queue.php: isinya sama
# dengan `database` kecuali retry_after yang jauh lebih panjang.
#
# JANGAN diisi `sync` di produksi: driver sync menjalankan job di dalam
# request yang sama, sehingga unggahan tetap memblokir halaman admin tanpa
# satu pun pesan galat.
UPLOAD_QUEUE_CONNECTION=uploads

# Berapa lama pekerjaan boleh dipegang worker sebelum antrean menganggapnya
# hilang. HARUS lebih besar dari UPLOAD_QUEUE_TIMEOUT. Kalau lebih kecil,
# unggahan yang masih berjalan akan diambil ulang worker lain dan ditandai
# gagal di tengah jalan.
UPLOAD_QUEUE_RETRY_AFTER=3900

# Nama antrean. Dipisahkan dari `default` supaya video 4 GB tidak menahan
# broadcast Telegram dan notifikasi di belakangnya.
#
# WAJIB didengarkan worker. Perintahnya harus memuat kedua antrean:
#   php artisan queue:work --queue=uploads,default
# Worker yang hanya mendengarkan `default` membuat setiap unggahan
# menggantung di status Menunggu selamanya, tanpa galat di mana pun.
UPLOAD_QUEUE=uploads

# Batas waktu satu pekerjaan, dalam detik. Harus lebih besar dari waktu
# terlama yang wajar untuk mengirim satu video, dan lebih kecil daripada
# UPLOAD_QUEUE_RETRY_AFTER di atas.
UPLOAD_QUEUE_TIMEOUT=3600

# Berapa kali dicoba otomatis sebelum ditandai Gagal. Bawaannya satu:
# pengulangan adalah keputusan admin lewat tombol Retry, bukan sesuatu yang
# terjadi diam-diam tiga kali untuk berkas berukuran gigabyte.
UPLOAD_QUEUE_TRIES=1

# Folder berkas staging, relatif terhadap storage/.
# TIDAK boleh di bawah app/public — folder itu tersaji ke publik lewat
# symlink public/storage, dan video berbayar yang menunggu antrean akan bisa
# diunduh siapa pun yang menebak namanya.
UPLOAD_QUEUE_STAGING=app/upload-queue

# Umur berkas staging milik pekerjaan yang sudah selesai, dalam hari.
# Dipakai `php artisan upload:prune`.
UPLOAD_QUEUE_KEEP_DAYS=7

# ---------------------------------------------------------------------------
# Sesi, antrean, cache
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# Aktifkan setelah Redis tersedia di server:
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
# SESSION_DRIVER=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@dramaverse.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Cadangan (Phase 9)
# ---------------------------------------------------------------------------
# Jumlah cadangan yang disimpan di disk VPS. Tujuh = seminggu bila harian.
# Cadangan yang hanya ada di server yang sama dengan aplikasinya bukan
# cadangan sesungguhnya — salin keluar server secara berkala.
BACKUP_KEEP=7

# Jam. Dashboard monitoring menandai merah bila cadangan terbaru lebih tua
# dari ini. 26, bukan 24: jadwal harian yang bergeser sedikit tidak boleh
# memicu peringatan palsu tiap hari.
BACKUP_MAX_AGE_HOURS=26

# Verifikasi arsip tepat setelah dibuat. Cadangan yang tidak pernah diperiksa
# baru diketahui rusak pada satu-satunya kali ia dibutuhkan.
BACKUP_VERIFY=true

# ---------------------------------------------------------------------------
# Pembayaran & Membership (Phase 10)
# ---------------------------------------------------------------------------
PAYMENT_CURRENCY=IDR
# Menit. Masa berlaku tagihan sebelum dikedaluwarsakan scheduler.
PAYMENT_INVOICE_TTL=1440

# Verifikasi ulang untuk callback yang tidak pernah sampai.
PAYMENT_VERIFY_MAX_ATTEMPTS=12
PAYMENT_VERIFY_BATCH=50
PAYMENT_QUEUE=default

# Detik. Cache status membership.
PAYMENT_MEMBERSHIP_CACHE_TTL=300

# Pencegahan penyalahgunaan.
PAYMENT_MAX_PENDING=3
PAYMENT_CALLBACK_RATE=60

PAYMENT_LOGGING=true
PAYMENT_LOG_CHANNEL=

# ---------------------------------------------------------------------------
# Analytics & Business Intelligence
# ---------------------------------------------------------------------------
# Cache dashboard. Matikan hanya saat menelusuri selisih angka — tanpa cache,
# dashboard menjalankan belasan query agregat setiap kali dibuka.
ANALYTICS_CACHE=true
ANALYTICS_CACHE_TTL=300

# Batas baris ekspor. Tanpa batas, ekspor setahun penuh menghentikan proses
# PHP di tengah unduhan dan berkasnya sampai dalam keadaan rusak.
ANALYTICS_REPORT_MAX_ROWS=20000
ANALYTICS_REPORT_PREVIEW=100
