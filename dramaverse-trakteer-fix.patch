+            return 0.0;
+        }
+
+        if (str_contains($angka, ',') && str_contains($angka, '.')) {
+            $angka = str_replace('.', '', $angka);
+            $angka = str_replace(',', '.', $angka);
+
+            return is_numeric($angka) ? (float) $angka : 0.0;
+        }
+
+        if (str_contains($angka, ',')) {
+            $bagian = explode(',', $angka);
+            $akhir = end($bagian);
+
+            $angka = strlen((string) $akhir) === 3
+                ? str_replace(',', '', $angka)
+                : str_replace(',', '.', $angka);
+
+            return is_numeric($angka) ? (float) $angka : 0.0;
+        }
+
+        if (str_contains($angka, '.')) {
+            $bagian = explode('.', $angka);
+            $akhir = end($bagian);
+
+            $angka = strlen((string) $akhir) === 3
+                ? str_replace('.', '', $angka)
+                : $angka;
+        }
+
+        return is_numeric($angka) ? (float) $angka : 0.0;
+    }
 }
