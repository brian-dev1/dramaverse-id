+    private function money(mixed $nilai): float
+    {
+        if (is_int($nilai) || is_float($nilai)) {
+            return (float) $nilai;
+        }
+
+        if (! is_string($nilai)) {
+            return 0.0;
+        }
+
+        $angka = trim(str_ireplace(['rp', 'idr', ' '], '', $nilai));
